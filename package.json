{
  "name": "ai-paper-pet",
  "productName": "AI论文宠物",
  "version": "0.1.4",
  "description": "面向中文人文社科研究的桌面论文助手：项目资料、研究对话、受控数据分析、正文编辑与 Word 导出",
  "main": "electron/main.js",
  "scripts": {
    "start": "node electron/start.js",
    "dev": "node electron/start.js",
    "test:stream": "node electron/stream-parser.test.js",
    "test:word": "node electron/word-export.test.js",
    "test:research": "node electron/research-workflow.test.js",
    "test:agent": "node electron/paper-writing-agent.test.js",
    "test:citations": "node electron/citation-format.test.js",
    "test:data-tools": "python scripts/data_analysis.test.py",
    "test:session": "node electron/writing-session.test.js",
    "test:parser": "node electron/document-parser.test.js",
    "test:thesis": "node electron/thesis-controller.test.js",
    "test:storage": "node electron/cache-storage.test.js",
    "test:migration": "node electron/workspace-store.test.js",
    "test:rag-cache": "node electron/rag-persistence.test.js",
    "test:agent-runtime": "node electron/agent-runtime.test.js",
    "test:skills": "node electron/skill-runtime.test.js",
    "test:ocr": "node electron/ocr-runtime.test.js",
    "test:orchestrator": "node electron/orchestrator.test.js",
    "test:model-layer": "node electron/pi/model-layer.test.mjs",
    "test:tool-cache": "node electron/tool-registry.test.js",
    "build:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sandbox.ps1",
    "test:sandbox": "node electron/sandbox-integration.test.js",
    "predist:win": "npm run build:sandbox",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1 -Mode preview",
    "test": "node scripts/test-all.js",
    "test:harness": "node electron/pi/harness.test.mjs",
    "test:local-edit": "node electron/local-edit.test.js",
    "test:ocr-integration": "node electron/ocr-integration.test.js",
    "test:ui": "electron scripts/ui-smoke.cjs",
    "diagnose:api": "electron electron/diagnose-api.js",
    "validate:real-paper": "electron electron/validate-real-paper.js",
    "release:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1 -Mode preview",
    "release:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1 -Mode signed",
    "audit:release": "node scripts/audit-dependencies.cjs"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "build": {
    "appId": "cn.openpaper.paperpet",
    "productName": "AI论文宠物",
    "asar": true,
    "asarUnpack": [
      "assets/ocr/**/*",
      "assets/sandbox/win32/*.exe",
      "scripts/data_analysis.py"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "!assets/research-skills/skills/49-voidborne-d-humanize-chinese/**/*",
      "!assets/research-skills/skills/54-scdenney-open-science-skills/**/*",
      "!assets/research-skills/skills/67-econfin-workflow-toolkit/significance-search/**/*",
      "electron/**/*",
      "src/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "SECURITY.md",
      "scripts/data_analysis.py",
      "!electron/*.test.js",
      "!electron/rag-smoke.js",
      "!electron/**/*.test.*",
      "!electron/pi/faux-provider.mjs",
      "!electron/diagnose-api.js",
      "!electron/validate-real-paper.js",
      "!assets/**/*.cs",
      "!assets/python/**/*",
      "!**/.env*",
      "!**/api-key*",
      "!**/*.sqlite*",
      "!**/*.log"
    ],
    "win": {
      "icon": "assets/icons/app-icon.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "signExts": [
        ".exe",
        ".dll",
        ".pyd",
        ".node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI论文宠物",
      "installerIcon": "assets/icons/app-icon.ico",
      "uninstallerIcon": "assets/icons/app-icon.ico",
      "artifactName": "AI论文宠物-安装程序-${version}.${ext}"
    },
    "afterPack": "scripts/verify-pack.cjs",
    "extraResources": [
      {
        "from": "assets/python/win32-x64",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/tests/**"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "protobufjs@7.6.6": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@huggingface/transformers": "4.3.1",
    "@napi-rs/canvas": "0.1.100",
    "@vscode/codicons": "0.0.39",
    "docx": "9.5.1",
    "jszip": "3.10.1",
    "pdfjs-dist": "5.4.530",
    "tesseract.js": "7.0.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri@3": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "js-yaml@4": "4.3.2",
    "undici@6": "6.29.0",
    "@xmldom/xmldom": "0.9.12",
    "sharp": "0.35.5"
  }
}
